         fhir:reference [ fhir:v "ValueSet/ie-core-alcohol-drinking-status" ]
       ] ;
       fhir:name [ fhir:v "IE Core Drinking Status" ] ;
       fhir:description [ fhir:v "The Drinking Status value set includes values that may be used to represent an individual’s current behaviour of alcohol drinking." ] ;
       fhir:example [
