       ] ;
       fhir:name [ fhir:v "IE Core Payer Type" ] ;
       fhir:description [ fhir:v "A set of concepts to classify Payer Type" ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ]
