           a fhir:string ;
           fhir:v "StructureDefinition:complex-type"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://iehr.ai/fhir/ie/core/StructureDefinition/ie-core-drugs-payment-scheme> ;
         fhir:reference [ fhir:v "StructureDefinition/ie-core-drugs-payment-scheme" ]
       ] ;
       fhir:name [ fhir:v "IE Core Drugs Payment Scheme" ] ;
       fhir:description [ fhir:v "This identifier profile defines a Drugs Payment Scheme (DPS) in an Irish context." ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:resource"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://iehr.ai/fhir/ie/core/StructureDefinition/ie-core-encounter> ;
         fhir:reference [ fhir:v "StructureDefinition/ie-core-encounter" ]
       ] ;
       fhir:name [ fhir:v "IE Core Encounter Profile" ] ;
       fhir:description [ fhir:v "The IE Core Encounter Profile inherits from the FHIR [Encounter](https://hl7.org/fhir/R4/encounter.html) resource; refer to it for scope and usage definitions. This profile sets minimum expectations for the Encounter resource to record, search, and fetch basic encounter information for an individual patient. It specifies which core elements, extensions, vocabularies, and value sets **SHALL** be present and constrains how the elements are used. Providing the floor for standards development for specific use cases promotes interoperability and adoption." ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "ValueSet"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://iehr.ai/fhir/ie/core/ValueSet/ie-core-encounter-type> ;
         fhir:reference [ fhir:v "ValueSet/ie-core-encounter-type" ]
       ] ;
       fhir:name [ fhir:v "IE Core Encounter Type" ] ;
       fhir:description [ fhir:v "The type of encounter: a specific code indicating type of service provided. This value set includes codes from SNOMED CT decending from the concept 308335008 (Patient encounter procedure (procedure)) and codes from the Current Procedure and Terminology (CPT) found in the following CPT sections:\n- 99211-99499 E/M - 99500-99600 home health (mainly nonphysician, such as newborn care in home) - 99605-99607 medication management - 98966-98968 non physician telephone services\n(subscription to AMA Required)" ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "ValueSet"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://iehr.ai/fhir/ie/core/ValueSet/ie-core-ethnicity> ;
         fhir:reference [ fhir:v "ValueSet/ie-core-ethnicity" ]
       ] ;
       fhir:name [ fhir:v "IE Core ethnicity" ] ;
       fhir:description [ fhir:v "This extension applies to the Patient, Person, and RelatedPerson resources and is used to indicate Ethnicity." ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
