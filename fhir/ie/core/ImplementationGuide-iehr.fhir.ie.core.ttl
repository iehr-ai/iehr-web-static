         fhir:reference [ fhir:v "ValueSet/ie-core-discharge-disposition" ]
       ] ;
       fhir:name [ fhir:v "IE Core Discharge Disposition" ] ;
       fhir:description [ fhir:v "[National Uniform Billing Committee](http://www.nubc.org/), manual UB-04, UB form locator 17." ] ;
       fhir:example [
