       ] ;
       fhir:name [ fhir:v "IE Core DocumentReferences Category Codes" ] ;
       fhir:description [ fhir:v "The IE Core DocumentReferences Type Code System is a 'starter set' of categories supported for fetching and storing DocumentReference Resources." ] ;
       fhir:example [
