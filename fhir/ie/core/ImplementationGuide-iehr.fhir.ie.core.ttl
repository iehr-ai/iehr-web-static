       ] ;
       fhir:name [ fhir:v "IE Core Medication Adherence Extension" ] ;
       fhir:description [ fhir:v "The Medication Adherence Extension is used to report whether a medication has been consumed according to instructions as reported by a patient or on behalf of the patient." ] ;
