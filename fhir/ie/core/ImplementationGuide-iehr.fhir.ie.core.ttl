       ] ;
       fhir:name [ fhir:v "IE Core Medical Record Number" ] ;
       fhir:description [ fhir:v "This identifier profile defines a  (MRN) (sometimes referred to as unit record number (URN) or (UR)) in an Irish context. An MRN is an institution's identifier for a patient's record at that institution. A patient may have more than one MRN for a single institution due to organisational restructures." ] ;
