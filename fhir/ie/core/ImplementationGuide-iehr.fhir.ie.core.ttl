         fhir:reference [ fhir:v "ValueSet/ie-core-documentreference-type" ]
       ] ;
       fhir:name [ fhir:v "IE Core DocumentReference Type" ] ;
       fhir:description [ fhir:v "The IE Core DocumentReference Type Value Set includes all LOINC values whose SCALE is \"Doc\" in the LOINC database and the HL7 v3 Code System NullFlavor concept 'unknown'" ] ;
