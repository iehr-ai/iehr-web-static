         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:complex-type"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://iehr.ai/fhir/ie/core/StructureDefinition/ie-core-general-medical-service> ;
         fhir:reference [ fhir:v "StructureDefinition/ie-core-general-medical-service" ]
       ] ;
       fhir:name [ fhir:v "IE Core General Medical Service" ] ;
       fhir:description [ fhir:v "This identifier profile defines a Medical Card/GP Visit Cards - General Medical Service (GMS) in an Irish context." ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "ValueSet"
         ]
