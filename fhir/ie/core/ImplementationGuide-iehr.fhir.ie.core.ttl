       ] ;
       fhir:name [ fhir:v "IE Core IECDI Requirement Extension" ] ;
       fhir:description [ fhir:v "**This extension is only used in the IE Core Implementation Guide''s Profile StructureDefinition elements.**  It flags elements that are *Additional* IECDI Requirements for certified systems. In other words, elements that are not marked as Must Support but are required for certification testing. See the [Conformance page](general-requirements.html) for more information." ] ;
