         fhir:reference [ fhir:v "StructureDefinition/ie-core-direct" ]
       ] ;
       fhir:name [ fhir:v "IE Core Direct email Extension" ] ;
       fhir:description [ fhir:v "This email address is associated with a [\"Direct Secure Messaging\"](https://directtrust.org/what-we-do/direct-secure-messaging) service.  This extension can only be used on contact points where the system = 'email'" ] ;
