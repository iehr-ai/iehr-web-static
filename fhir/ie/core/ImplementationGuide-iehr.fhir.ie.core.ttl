         fhir:reference [ fhir:v "ValueSet/ie-core-narrative-status" ]
       ] ;
       fhir:name [ fhir:v "IE Core Narrative Status" ] ;
       fhir:description [ fhir:v "The IE Core Narrative Status Value Set limits the text status for the resource narrative." ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
