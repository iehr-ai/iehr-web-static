       fhir:supportedProfile ( [
         fhir:v "http://iehr.ai/fhir/ie/core/StructureDefinition/ie-core-medicationrequest"^^xsd:anyURI ;
         fhir:link <http://iehr.ai/fhir/ie/core/StructureDefinition/ie-core-medicationrequest> ;
         fhir:extension ( [
