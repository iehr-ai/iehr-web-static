  fhir:rest ( [
     fhir:mode [ fhir:v "server" ] ;
     fhir:documentation [ fhir:v "The IE Core Server **SHALL**:\n\n1. Support the IE Core Patient resource profile AND at least one additional resource profile from the list of IE Core Profiles AND and all Must Support IE Core Profiles and resources it references.\n     - The Table below summarizes the Must Support references to other IE Core Profiles and FHIR resources for each IE Core Profile:\n1. Implement the RESTful behavior according to the FHIR specification.\n1. Follow the requirements documented in the [General Requirements](general-requirements.html) and [Must Support](must-support.html) pages\n1. Return the following response classes:\n   - (Status 400): invalid parameter\n   - (Status 401/4xx): unauthorized request\n   - (Status 403): insufficient scopes\n   - (Status 404): unknown resource\n1. Support JSON source formats for all IE Core interactions.\n\nThe IE Core Server **SHOULD**:\n\n1. Follow the guidance documented in the [General Guidance](general-guidance.html) page\n1. Support XML source formats for all IE Core interactions.\n1. Identify the IE Core profiles supported as part of the FHIR `meta.profile` attribute for each instance.\n" ] ;
     fhir:security [
       fhir:description [ fhir:v "1. See the [General Security Considerations](security.html) section for requirements and recommendations.\n1. A server **SHALL** reject any unauthorized requests by returning an `HTTP 401` \"Unauthorized\", `HTTP 403` \"Forbidden\", or `HTTP 404` \"Not Found\"" ]
     ] ;
