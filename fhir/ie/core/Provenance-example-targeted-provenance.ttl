       fhir:value [
         a fhir:markdown ;
         fhir:v "This is a provenance example for the *IE Core Provenance Profile* to demonstrate how Provenance can be used to document the source of individual elements such as Race and Ethnicity (R/E), gender identity."
       ]
     ] ) ;
     fhir:profile ( [
       fhir:v "http://iehr.ai/fhir/ie/core/StructureDefinition/ie-core-provenance"^^xsd:anyURI ;
