       ]
     ] ) ;
     fhir:reference [ fhir:v "Patient/example-targeted-provenance" ]
  ] ) ; # 
  fhir:recorded [ fhir:v "2023-02-28T15:26:23.217+00:00"^^xsd:dateTime] ; # 
  fhir:agent ( [
     fhir:type [
